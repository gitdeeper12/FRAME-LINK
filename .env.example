# FRAME-LINK Environment Configuration
# Copy this file to .env and modify values as needed

# Application Settings
APP_NAME=FRAME-LINK
APP_VERSION=1.0.0
ENVIRONMENT=production

# Connection Analysis Configuration
CONNECTION_TYPE=welded_t_joint
ANALYSIS_MODE=fatigue

# Sensor Configuration
SENSOR_STREAM_ENABLED=true
SENSOR_STREAM_PORT=8080
STRAIN_SAMPLE_RATE_HZ=1000
AE_SAMPLE_RATE_MHZ=5

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Fracture Mechanics Parameters
PARIS_C=3e-13
PARIS_M=3.0
FRACTURE_TOUGHNESS_MPA_SQRT_M=80

# Fatigue Parameters
FATIGUE_CLASS=FAT71
DAMAGE_LIMIT=0.80
BETA_TARGET=3.8

# AI Model Configuration
AI_MODEL_PATH=/models/frame_link_xgboost.json
AI_FORECAST_HORIZON_HOURS=48

# Monitoring Dashboard
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8501

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/frame_link/frame_link.log

# Archival Settings
ARCHIVAL_PATH=/data/frame_link/archival
ARCHIVAL_CHECKSUM_ENABLED=true

# Notification Settings
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=engineer@frame-link.io

# Security
SECRET_KEY=change-this-in-production

# Development Only
DEBUG=false
