include README.md
include LICENSE
include VERSION
include NOTICE
include CHANGELOG.md
include AUTHORS.md
include CONTRIBUTING.md
include CODE_OF_CONDUCT.md
include SECURITY.md
include CITATION.cff
include .env.example
include .pre-commit-config.yaml

include pyproject.toml
include setup.cfg
include requirements*.txt

recursive-include docs *.md *.rst *.html
recursive-include paper *.pdf *.docx
recursive-include frame_link/configs *.yaml *.yml
recursive-include simulation *.json
recursive-include examples *.ipynb *.py

recursive-include frame_link/monitoring/assets *

global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
prune tests
prune docs/_build
prune .git
prune .github
